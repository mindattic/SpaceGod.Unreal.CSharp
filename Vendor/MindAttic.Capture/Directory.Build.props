<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <!-- SpaceGod.Unreal.CSharp (US-T72): quiet the missing-XML-doc warnings in the game build log. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Company>MindAttic</Company>
    <Authors>MindAttic</Authors>
    <Copyright>Copyright (c) 2026 MindAttic</Copyright>
  </PropertyGroup>
</Project>
