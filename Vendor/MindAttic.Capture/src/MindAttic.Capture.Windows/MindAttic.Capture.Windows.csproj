<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SpaceGod.Unreal.CSharp (US-T72): net10.0, not net10.0-windows10.0.19041.0, because UnrealSharp builds the game as
         plain net10.0 and NuGet will not let it reference a Windows-TFM project. That rules out the WinRT projection, so
         Windows Graphics Capture (Wgc/) is compiled out and a window is captured as its rectangle on screen
         (Desktop Duplication, then GDI) - DesktopCaptureHost's own fallback. -->
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);MINDATTIC_NO_WGC</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>MindAttic.Capture.Windows</PackageId>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <Description>Windows desktop capture for MindAttic.Capture: monitors, regions and windows (Windows Graphics Capture, Desktop Duplication, GDI), WASAPI audio, global hotkeys, DI wiring.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Wgc/**" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute"><_Parameter1>windows</_Parameter1></AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Capture\MindAttic.Capture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Capture.Windows.Tests" />
    <InternalsVisibleTo Include="capture" />
  </ItemGroup>

</Project>
