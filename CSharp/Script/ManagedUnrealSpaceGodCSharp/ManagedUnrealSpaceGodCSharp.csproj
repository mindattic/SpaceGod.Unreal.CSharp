<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# track's game code (UnrealSharp user project, named Managed<ProjectName> as the plugin expects).
       The simulation is NOT here: it is Unity.SpaceGod's own Core, compiled in place by ../../Core/SpaceGod.Core
       and referenced as a plain netstandard2.1 library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Off (US-T26): the port keeps the original Unity files' own usings; an implicit using System would make Object and Random
         ambiguous with UnityEngine's, which the originals never had to qualify. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ManagedUnrealSpaceGodCSharp</RootNamespace>
  </PropertyGroup>
  <Import Project="../../Plugins/UnrealSharp/UnrealSharp.Shared.props" />
  <ItemGroup>
    <!-- US-T41: cross-track saves (the static-name fix and the post-load delegate wiring), shared with Bench/CSharp. -->
    <Compile Include="../../Core/SaveCompat/*.cs" LinkBase="SaveCompat" />
    <ProjectReference Include="../../Core/SpaceGod.Core/SpaceGod.Core.csproj" />
    <!-- US-T72: MindAttic.Capture, vendored (Vendor/MindAttic.Capture): the engine and its Windows desktop host. The game
         window is recorded as its rectangle on screen; UnityCompat/CaptureUnity.cs is the Unity package's CaptureUnity. -->
    <ProjectReference Include="../../../Vendor/MindAttic.Capture/src/MindAttic.Capture.Windows/MindAttic.Capture.Windows.csproj" />
  </ItemGroup>
  <!-- US-T72: -capture is honoured only in a build with MINDATTIC_CAPTURE, as in the Unity package. On by default
       (still off at run time unless -capture is on the command line); dotnet build -p:SpaceGodCapture=false leaves it out. -->
  <PropertyGroup Condition="'$(SpaceGodCapture)' != 'false'">
    <DefineConstants>$(DefineConstants);MINDATTIC_CAPTURE</DefineConstants>
  </PropertyGroup>
</Project>
