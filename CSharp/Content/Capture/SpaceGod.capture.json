    { "on": "system-arrival", "action": "screenshot", "tag": "arrival", "cooldown": "5s" },
    { "on": "star-discovered", "action": "screenshot", "tag": "discovery", "cooldown": "5s" },
    { "on": "*", "action": "marker" }
