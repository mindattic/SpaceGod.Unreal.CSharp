<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity.Shared's engine-free Unity.Shared.Core (player profiles, settings.json): Runtime/Core of the package at
       Unity.Shared 3ce3b8a, compiled from this repo's own copy in Vendor/Unity.Shared/Core (see Vendor/README.md),
       as Unity.SpaceGod's Tests/Unity.Shared.Core does (.NET Standard 2.1, C# 9). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Unity.Shared.Core</AssemblyName>
    <RootNamespace>Unity.Shared.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <VendorCoreDir>$(MSBuildThisFileDirectory)../../../../Vendor/Unity.Shared/Core/</VendorCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(VendorCoreDir)**/*.cs" LinkBase="Core" />
  </ItemGroup>
</Project>
