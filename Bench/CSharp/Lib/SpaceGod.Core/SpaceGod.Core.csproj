<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity.SpaceGod's engine-free simulation (Assets/UnitySpace/Core/**/*.cs at Unity.SpaceGod 45dc06b), compiled
       unchanged from this repo's own copy in Vendor/Unity.SpaceGod/Core (see Vendor/README.md), as Unity.SpaceGod's
       Tests/UnitySpace.Core csproj does (.NET Standard 2.1, C# 9, assembly Unity.SpaceGod.Core). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Unity.SpaceGod.Core</AssemblyName>
    <RootNamespace>Unity.SpaceGod.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0067;CS1998</NoWarn>
    <VendorCoreDir>$(MSBuildThisFileDirectory)../../../../Vendor/Unity.SpaceGod/Core/</VendorCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(VendorCoreDir)**/*.cs" LinkBase="Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Unity.Shared.Core/Unity.Shared.Core.csproj" />
  </ItemGroup>
</Project>
